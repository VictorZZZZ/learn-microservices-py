# Шаблон переменных окружения.
# Скопируйте в .env и заполните свои значения:
#   cp .env.example .env
# .env локально можно и не создавать — переменные можно задать в среде
# (например, в Run Configuration PyCharm) или экспортировать в терминале.
# DATABASE_PORT можно не указывать — есть дефолт 5432.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=learn-py-profiles

# true — печатать SQL-запросы в лог (для локальной отладки)
LOG_SQL=false

# Секрет для проверки access-токенов auth-сервиса.
# ДОЛЖЕН совпадать с JWT_SECRET auth-сервиса: подпись HS256 симметричная —
# проверить токен может только владелец того же секрета, что его подписал.
JWT_SECRET=change-me-at-least-32-characters-long
